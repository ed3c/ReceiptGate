# ReceiptGate Hackathon demo. Copy to .env locally; never commit .env.
ZERO_G_ATTESTOR_URL=https://agenticid.0g.ai

# Runtime-only 0G Compute credentials. ZG_API_SECRET should be an app-sk-* value.
ZG_SERVICE_URL=
ZG_MODEL=
ZG_API_SECRET=

# Public URL of a freshly running Agentic ID runtime after provisioning.
RECEIPTGATE_AGENT_URL=

# LOCAL PROVISIONING ONLY. Never put PRIVATE_KEY in the repository.
PRIVATE_KEY=
AGENT_API_KEY=
ZG_AGENT_MODEL=
ZG_AGENT_FRAMEWORK=openclaw
ZG_AGENT_NAME=ReceiptGate Demo Agent
ZG_AGENT_IDEMPOTENCY_KEY=receiptgate-hackathon-demo-v1

# Official 0G Compute CLI provisioning inputs.
ZG_PROVIDER_ADDRESS=
ZG_DEPOSIT_AMOUNT=3
ZG_PROVIDER_FUND_AMOUNT=1
ZG_TOKEN_ID=7
