{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bun-types"
    ]
  },
  "include": [
    "api/**/*.ts",
    "demo/**/*.ts",
    "adapters/**/*.ts",
    "core/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
